# BlueStream Water Delivery Platform - Environment Configuration Template
# Copy this file to .env and update the values for your environment

# ===== Flask Configuration =====
FLASK_ENV=development
# Set to 'production' for production deployment
# Set to 'development' for local development
# Set to 'testing' for test runs

# CRITICAL: Always set to False in production
DEBUG=False

# CRITICAL: Use a strong random key (at least 32 characters)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
#
# Each secret below is a *distinct* trust boundary — generate four independent
# random values, do NOT reuse one across them. Reusing collapses the boundaries
# and means a leak of any one compromises the others.
#
#   SECRET_KEY          — Flask session signing / CSRF (backend only)
#   JWT_SECRET_KEY      — JWT auth tokens (backend ↔ telegram_bot API client)
#   BOT_WEBHOOK_SECRET  — HMAC for backend → telegram_bot /internal/* webhooks
#                         (must be IDENTICAL on backend and telegram_bot)
#   WEBHOOK_SECRET      — HMAC for backend → staff_bot /internal/* webhooks
#                         (must be IDENTICAL on backend and staff_bot)
SECRET_KEY=change-this-to-a-strong-random-key-in-production

# JWT signing key for API auth tokens issued to the Telegram bots.
JWT_SECRET_KEY=change-this-to-a-different-strong-random-key

# HMAC secret for the main customer telegram_bot's /internal/* webhook
# endpoints (e.g. payment-success notifications). Backend signs with this,
# telegram_bot verifies with the same value. A mismatch surfaces as a 401
# "Invalid webhook signature" in telegram_bot logs and silently drops
# customer-facing payment success notifications.
BOT_WEBHOOK_SECRET=change-this-to-a-third-strong-random-key

# HMAC secret for the staff_bot's /internal/* webhook endpoints (new-order
# notifications, route updates, etc). Backend signs with this; staff_bot
# verifies with the same value. Distinct from BOT_WEBHOOK_SECRET above —
# the two bots are independent trust domains.
WEBHOOK_SECRET=change-this-to-a-fourth-strong-random-key

# ===== Database Configuration =====
# Required: Database password must be set
DB_USER=postgres
DB_PASSWORD=your-secure-database-password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bluestream_db

# Alternative: Full database URL (overrides individual DB_ variables)
# DATABASE_URL=postgresql://user:password@host:port/database

# ===== Redis Configuration =====
REDIS_URL=redis://localhost:6379/0

# ===== Payment Gateway Configuration =====
# Payme Gateway
PAYME_MERCHANT_ID=your-payme-merchant-id
PAYME_SECRET_KEY=your-payme-secret-key
PAYME_TEST_MODE=True
PAYME_ENDPOINT_URL=https://checkout.test.paycom.uz

# Click Gateway
CLICK_MERCHANT_ID=your-click-merchant-id
CLICK_SERVICE_ID=your-click-service-id
CLICK_SECRET_KEY=your-click-secret-key
CLICK_TEST_MODE=True
CLICK_ENDPOINT_URL=https://api.click.uz/v2/merchant
CLICK_MERCHANT_API_USER_ID=your-click-merchant-api-user-id
CLICK_MERCHANT_API_SECRET_KEY=your-click-merchant-api-secret-key
CLICK_MERCHANT_API_TIMEOUT_SECONDS=30

# Optional Click Merchant API endpoint overrides
# CLICK_MERCHANT_STATUS_URL=
# CLICK_MERCHANT_REFUND_URL=
# CLICK_MERCHANT_FISCALIZATION_URL=
# CLICK_MERCHANT_OFD_DATA_URL=
# CLICK_MERCHANT_SUBMIT_QRCODE_URL=
# CLICK_MERCHANT_API_STATUS_PATH=
# CLICK_MERCHANT_API_REFUND_PATH=
# CLICK_MERCHANT_API_FISCALIZATION_PATH=
# CLICK_MERCHANT_API_OFD_DATA_PATH=
# CLICK_MERCHANT_API_SUBMIT_QRCODE_PATH=
# CLICK_FISCALIZATION_OFD_RETRY_DELAY_SECONDS=300
# CLICK_FISCALIZATION_OFD_RETRY_MAX_ATTEMPTS=5

# ===== Telegram Bot Configuration =====
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
STAFF_BOT_TOKEN=your-staff-telegram-bot-token
WEBHOOK_URL=https://your-domain.com/telegram/webhook
TELEGRAM_ADMIN_CHAT_ID=your-admin-chat-id

# ===== Email Configuration =====
SENDGRID_API_KEY=your-sendgrid-api-key
MAIL_DEFAULT_SENDER=noreply@waterbusiness.com
MAIL_SUPPORT_EMAIL=support@waterbusiness.com

# ===== SMS Configuration =====
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=your-twilio-phone-number

# ===== File Storage Configuration =====
STORAGE_TYPE=local
# Set to 's3' for AWS S3 storage, 'local' for local file storage
UPLOAD_FOLDER=uploads/
MAX_UPLOAD_SIZE=16777216

# AWS S3 Configuration (only if STORAGE_TYPE=s3)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=your-s3-bucket-name
AWS_REGION=us-east-1

# ===== Maps Configuration =====
# Provider for geocoding only. Routing uses the dedicated fallback chain
# below regardless of this setting.
# 'google' | 'yandex' | 'osm'. Selects the provider for get_route() —
# used by the admin dispatch map's road geometry
# (business_app/api/admin_dispatch.py::dispatch_route_geometry).
# As of 2026-08-13 'osm' means OUR self-hosted OSRM at OSRM_BASE_URL (it
# used to mean the public demo server), so it is now free, local and
# rate-limit-free for route geometry. Requires COMPOSE_PROFILES=routing.
MAPS_PROVIDER=yandex
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
YANDEX_MAPS_API_KEY=your-yandex-maps-api-key
# HERE Matrix Routing v8 — legacy fallback routing provider (traffic-aware,
# 250k free requests/month). Sign up at https://platform.here.com to
# obtain a free API key. Since route UX phase 2 this tier only runs when
# LEGACY_MATRIX_PROVIDERS_ENABLED=true — the primary matrix source is the
# self-hosted OSRM service.
HERE_MAPS_API_KEY=your-here-maps-api-key
# Google Routes computeRoutes key — traffic-aware NEXT-LEG ETA only (one
# number, spec 8.2). Bills per REQUEST (~2,700/month at current fleet size,
# inside the 5,000/month free Pro allowance). NEVER the matrix endpoint
# (bills per ELEMENT). Deliberately a separate key from GOOGLE_MAPS_API_KEY
# above — optional; unset means this tier is silently skipped and the
# OSRM/matrix duration is used instead.
GOOGLE_ROUTES_API_KEY=

# ===== Route Optimization =====
# How long traffic-aware vs static distance-matrix results are cached in Redis.
# Since the phase-2 cache split, the matrix wrapper's static (stop<->stop)
# tier reads MATRIX_CACHE_TTL_TRAFFIC_SECONDS only when a call passes
# traffic=True AND the provider that answered it is genuinely traffic-aware
# (HERE/Yandex, only reachable behind LEGACY_MATRIX_PROVIDERS_ENABLED) --
# self-hosted/public OSRM are free-flow regardless of the traffic flag, so
# they always get MATRIX_CACHE_TTL_STATIC_SECONDS. The raw traffic flag
# alone does NOT control the TTL. The live-origin tier always uses
# MATRIX_LIVE_ORIGIN_TTL_SECONDS regardless of source.
MATRIX_CACHE_TTL_TRAFFIC_SECONDS=1800
MATRIX_CACHE_TTL_STATIC_SECONDS=86400
# Live origin-row cache tier TTL (seconds).
MATRIX_LIVE_ORIGIN_TTL_SECONDS=120
# A driver's last_location_update older than this is treated as "stale".
DRIVER_LOCATION_FRESH_SECONDS=1800
# Flat per-stop service time (minutes) folded into route duration totals.
ROUTE_SERVICE_TIME_MINUTES=4
# Warehouse/depot coordinate. NEVER a route stop: used only as the
# last-resort route start anchor for route optimization. NOT the
# delivery-fee distance origin.
WAREHOUSE_LATITUDE=41.2995
WAREHOUSE_LONGITUDE=69.2401
# Staff bot URL for backend → bot push (route-updated, pool-insertion-suggestion).
STAFF_BOT_WEBHOOK_URL=http://staff_bot:8081

# ===== Self-hosted OSRM (route UX phase 2) =====
# Enable the `osrm` compose service (prepared data required in ./osrm_data/,
# see scripts/prepare_osrm_data.sh). Leave unset in dev to skip the service.
#COMPOSE_PROFILES=routing
# Primary distance-matrix provider. Empty string disables the tier — this is
# the documented rollback lever (docs/routing_engine_deploy_rollback.md).
OSRM_BASE_URL=http://osrm:5000
# EMERGENCY-ONLY fallback to the public OSRM demo server (its usage policy
# forbids production use). Off by default.
OSRM_PUBLIC_FALLBACK_ENABLED=false
# HERE/Yandex matrix tiers: 403/401 on every production call (keys not
# entitled to the matrix products) — removed from the hot path. Re-enable
# only after fixing the entitlements.
LEGACY_MATRIX_PROVIDERS_ENABLED=false

# ===== Business Configuration =====
COMPANY_NAME=AquaPure Water Delivery
COMPANY_LEGAL_NAME=
COMPANY_PHONE=+998901234567
COMPANY_EMAIL=info@waterbusiness.com
COMPANY_ADDRESS=Tashkent, Uzbekistan
COMPANY_WEBSITE=https://waterbusiness.com
COMPANY_TIN=
COMPANY_PINFL=

# ===== SEO / GEO (Generative Engine Optimization) =====
# All values OPTIONAL. Empty values cause the relevant snippet to be omitted at
# render time so we never publish placeholder data to LLMs / search engines.
# These power the Organization + LocalBusiness JSON-LD blocks in base.html.
COMPANY_FOUNDING_DATE=
# Absolute URL for company logo (defaults to site logo if empty)
COMPANY_LOGO_URL=
COMPANY_STREET_ADDRESS=
COMPANY_CITY=Tashkent
COMPANY_REGION=Tashkent Region
COMPANY_POSTAL_CODE=
COMPANY_COUNTRY_CODE=UZ
# Geo coordinates of the storefront/HQ (decimal degrees)
COMPANY_GEO_LATITUDE=
COMPANY_GEO_LONGITUDE=
# Comma-separate multiple specs, e.g. "Mo-Sa 09:00-21:00,Su 10:00-18:00"
COMPANY_OPENING_HOURS=
COMPANY_PRICE_RANGE=$$
# External brand-identity links — Wikidata is the highest-leverage GEO signal.
# Fill once Milestone 3 of the visibility plan is shipped.
COMPANY_WIKIDATA_ID=
COMPANY_WIKIPEDIA_URL=
COMPANY_FACEBOOK_URL=
COMPANY_YOUTUBE_URL=
COMPANY_GOOGLE_BUSINESS_URL=
COMPANY_YANDEX_BUSINESS_URL=
COMPANY_TWOGIS_URL=
# Social handles already supported by the template
COMPANY_INSTAGRAM_URL=
COMPANY_INSTAGRAM_HANDLE=
COMPANY_TELEGRAM_CHANNEL_URL=
COMPANY_TELEGRAM_CHANNEL_HANDLE=
COMPANY_TELEGRAM_BOT_URL=
COMPANY_TELEGRAM_BOT_HANDLE=

# ===== Web Analytics & Search-Console Verification =====
# GA4 / Yandex Metrica snippets only render in base.html when these are set.
GA4_MEASUREMENT_ID=
YANDEX_METRICA_ID=
GOOGLE_SITE_VERIFICATION=
YANDEX_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Delivery fiscalization profile (required when delivery_fee > 0 for Click fiscalization)
# CLICK_DELIVERY_FISCAL_NAME=Delivery
# CLICK_DELIVERY_FISCAL_BARCODE=
# CLICK_DELIVERY_FISCAL_SPIC=
# CLICK_DELIVERY_FISCAL_PACKAGE_CODE=
# CLICK_DELIVERY_FISCAL_UNITS=
# CLICK_DELIVERY_FISCAL_VAT_PERCENT=0

# ===== Delivery Configuration =====
# Delivery is currently free. Flat env-driven fee (0 = free); a future zone-based
# model will set per-zone fees. There is no amount-based free-delivery threshold.
DEFAULT_DELIVERY_FEE=0
DELIVERY_RADIUS_KM=20
MAX_DELIVERY_TIME_HOURS=24
MIN_ORDER_AMOUNT=20000

# ===== Loyalty Program Configuration =====
# UZS spent per earned point (earning is DB-driven via LoyaltyProgram.uzs_per_point;
# this is the legacy fallback). Points are redeemed only via rewards — there is no
# points→UZS conversion, so there is no LOYALTY_REDEMPTION_RATIO.
LOYALTY_POINTS_RATIO=250
REFERRAL_BONUS_POINTS=500

# ===== Security Configuration =====
PASSWORD_MIN_LENGTH=8
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=1800

# ===== Rate Limiting Configuration =====
RATE_LIMIT_REQUESTS=100/hour

# ===== Logging Configuration =====
LOG_LEVEL=INFO
# Set to WARNING in production, DEBUG for development
LOG_FILE=logs/app.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# ===== Monitoring Configuration =====
# Sentry for error tracking (production)
SENTRY_DSN=your-sentry-dsn-url

# MON-SUB: Grafana admin password (REQUIRED in production overlay — Grafana
# is now exposed at https://grafana.aqua-element.uz, no default fallback).
# Generate with: openssl rand -base64 24
GRAFANA_PASSWORD=change-me-to-a-long-random-string

# MON-SUB: shared basic-auth credential for the raw-API monitoring
# subdomains (prometheus.*, loki.*, alertmanager.aqua-element.uz). Format:
# user:password — same shape as FLOWER_BASIC_AUTH. nginx materialises an
# htpasswd file from this at container start — see
# nginx/docker-entrypoint.d/40-monitoring-htpasswd.sh. Apply changes with
# `docker compose up -d --force-recreate nginx`.
MONITORING_BASIC_AUTH=admin:change-me-to-a-long-random-string

# ===== Celery Configuration =====
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# CEL-006: Flower dashboard basic auth (REQUIRED — flower service won't start
# without it). Format: user:password. Use a long random password; Flower is
# now exposed at https://flower.aqua-element.uz, so this is the public auth.
FLOWER_BASIC_AUTH=admin:change-me-to-a-long-random-string

# ===== COD Reconciliation / Cash Custody =====
COD_CASH_WARNING_THRESHOLD_UZS=200000
COD_CASH_ESCALATION_THRESHOLD_UZS=400000
COD_RECONCILIATION_CUTOFF_LOCAL=23:00
COD_REMINDER_INTERVAL_MINUTES=60
COD_RECONCILIATION_WARNING_DAYS=7

# ===== Production-Only Settings =====
# These should only be set in production environments

# Force HTTPS (production only)
# FORCE_HTTPS=True

# CORS origins (update for your domains)
# CORS_ORIGINS=https://yourdomain.com,https://admin.yourdomain.com
