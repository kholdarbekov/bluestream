# BlueStream Water Delivery Platform - Environment Configuration Template
# Copy this file to .env and update the values for your environment

# ===== Flask Configuration =====
FLASK_ENV=development
# Set to 'production' for production deployment
# Set to 'development' for local development
# Set to 'testing' for test runs

# CRITICAL: Always set to False in production
DEBUG=False

# CRITICAL: Use a strong random key (at least 32 characters)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
#
# Each secret below is a *distinct* trust boundary — generate four independent
# random values, do NOT reuse one across them. Reusing collapses the boundaries
# and means a leak of any one compromises the others.
#
#   SECRET_KEY          — Flask session signing / CSRF (backend only)
#   JWT_SECRET_KEY      — JWT auth tokens (backend ↔ telegram_bot API client)
#   BOT_WEBHOOK_SECRET  — HMAC for backend → telegram_bot /internal/* webhooks
#                         (must be IDENTICAL on backend and telegram_bot)
#   WEBHOOK_SECRET      — HMAC for backend → staff_bot /internal/* webhooks
#                         (must be IDENTICAL on backend and staff_bot)
SECRET_KEY=change-this-to-a-strong-random-key-in-production

# JWT signing key for API auth tokens issued to the Telegram bots.
JWT_SECRET_KEY=change-this-to-a-different-strong-random-key

# HMAC secret for the main customer telegram_bot's /internal/* webhook
# endpoints (e.g. payment-success notifications). Backend signs with this,
# telegram_bot verifies with the same value. A mismatch surfaces as a 401
# "Invalid webhook signature" in telegram_bot logs and silently drops
# customer-facing payment success notifications.
BOT_WEBHOOK_SECRET=change-this-to-a-third-strong-random-key

# HMAC secret for the staff_bot's /internal/* webhook endpoints (new-order
# notifications, route updates, etc). Backend signs with this; staff_bot
# verifies with the same value. Distinct from BOT_WEBHOOK_SECRET above —
# the two bots are independent trust domains.
WEBHOOK_SECRET=change-this-to-a-fourth-strong-random-key

# ===== Database Configuration =====
# Required: Database password must be set
DB_USER=postgres
DB_PASSWORD=your-secure-database-password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bluestream_db

# Alternative: Full database URL (overrides individual DB_ variables)
# DATABASE_URL=postgresql://user:password@host:port/database

# ===== Redis Configuration =====
REDIS_URL=redis://localhost:6379/0

# ===== Payment Gateway Configuration =====
# Payme Gateway
PAYME_MERCHANT_ID=your-payme-merchant-id
PAYME_SECRET_KEY=your-payme-secret-key
PAYME_TEST_MODE=True
PAYME_ENDPOINT_URL=https://checkout.test.paycom.uz

# Click Gateway
CLICK_MERCHANT_ID=your-click-merchant-id
CLICK_SERVICE_ID=your-click-service-id
CLICK_SECRET_KEY=your-click-secret-key
CLICK_TEST_MODE=True
CLICK_ENDPOINT_URL=https://api.click.uz/v2/merchant
CLICK_MERCHANT_API_USER_ID=your-click-merchant-api-user-id
CLICK_MERCHANT_API_SECRET_KEY=your-click-merchant-api-secret-key
CLICK_MERCHANT_API_TIMEOUT_SECONDS=30

# Optional Click Merchant API endpoint overrides
# CLICK_MERCHANT_STATUS_URL=
# CLICK_MERCHANT_REFUND_URL=
# CLICK_MERCHANT_FISCALIZATION_URL=
# CLICK_MERCHANT_OFD_DATA_URL=
# CLICK_MERCHANT_SUBMIT_QRCODE_URL=
# CLICK_MERCHANT_API_STATUS_PATH=
# CLICK_MERCHANT_API_REFUND_PATH=
# CLICK_MERCHANT_API_FISCALIZATION_PATH=
# CLICK_MERCHANT_API_OFD_DATA_PATH=
# CLICK_MERCHANT_API_SUBMIT_QRCODE_PATH=
# CLICK_FISCALIZATION_OFD_RETRY_DELAY_SECONDS=300
# CLICK_FISCALIZATION_OFD_RETRY_MAX_ATTEMPTS=5

# ===== Telegram Bot Configuration =====
# WARNING: rotating TELEGRAM_BOT_TOKEN permanently breaks every previously
# received Support Inbox attachment (photos/documents/voice/video). They are
# stored as Telegram file_ids, not bytes, and a file_id is scoped to the bot
# token that received it. Captions/text survive; media 404s forever. See
# docs/CONFIGURATION.md for details before rotating.
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
STAFF_BOT_TOKEN=your-staff-telegram-bot-token
WEBHOOK_URL=https://your-domain.com/telegram/webhook
TELEGRAM_ADMIN_CHAT_ID=your-admin-chat-id

# ===== Email Configuration =====
SENDGRID_API_KEY=your-sendgrid-api-key
MAIL_DEFAULT_SENDER=noreply@waterbusiness.com
MAIL_SUPPORT_EMAIL=support@waterbusiness.com

# ===== SMS Configuration =====
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=your-twilio-phone-number

# ===== File Storage Configuration =====
STORAGE_TYPE=local
# Set to 's3' for AWS S3 storage, 'local' for local file storage
UPLOAD_FOLDER=uploads/
MAX_UPLOAD_SIZE=16777216

# AWS S3 Configuration (only if STORAGE_TYPE=s3)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=your-s3-bucket-name
AWS_REGION=us-east-1

# ===== Maps Configuration =====
# Provider for geocoding only. Routing uses the dedicated fallback chain
# below regardless of this setting.
# 'google' | 'yandex' | 'osm'. Selects the provider for get_route() —
# used by the admin dispatch map's road geometry
# (business_app/api/admin_dispatch.py::dispatch_route_geometry).
# As of 2026-08-13 'osm' means OUR self-hosted OSRM at OSRM_BASE_URL (it
# used to mean the public demo server), so it is now free, local and
# rate-limit-free for route geometry. Requires COMPOSE_PROFILES=routing.
MAPS_PROVIDER=yandex
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
YANDEX_MAPS_API_KEY=your-yandex-maps-api-key
# A third paid matrix-provider credential was removed on 2026-08-16 after it
# billed us; self-hosted OSRM (OSRM_BASE_URL, below) replaced it entirely.
# Google Routes computeRoutes key. Google Routes TRAFFIC_AWARE is called ONLY
# when a driver taps "on the way", to work out the customer's arrival time
# (business_app/services/delivery_eta_service.py). The driver's route card
# never calls it: it uses our own engine (the distance matrix, self-hosted
# OSRM). Bills per REQUEST; NEVER the matrix endpoint (bills per ELEMENT).
# Every call is capped per Tashkent day by GOOGLE_ROUTES_DAILY_CAP, below.
# Deliberately a separate key from GOOGLE_MAPS_API_KEY above. Optional: unset
# means no Google call at all: a tap from a fresh driver position shows customers
# "On the way" with no minutes, and one from an older position keeps our own
# engine's estimate.
GOOGLE_ROUTES_API_KEY=
# The eight settings below are commented out on purpose, so a copy of a default
# cannot shadow a retuned one: uncomment one to override it. Defaults live in
# shared/business_config.py (a blank value means the default).
# Google Routes calls allowed per Tashkent day (150 x 31 days = 4,650, inside
# Google's 5,000/month free allowance). 0 switches Google off.
#GOOGLE_ROUTES_DAILY_CAP=150
# "On the way" arrival promise: Google is asked only from a driver position at
# most this many seconds old at the tap.
#ETA_POSITION_MAX_AGE_SECONDS=600
# Minutes off the road at the door end: parking, the walk, the stairs.
#ETA_OFF_ROAD_MINUTES=5
# Headroom, the factor on Google's drive time, while fewer than
# ETA_HEADROOM_MIN_LEGS legs are recorded.
#ETA_HEADROOM_SEED=1.3
# Legs recorded before headroom is learned from the last four weeks.
#ETA_HEADROOM_MIN_LEGS=30
# How many legs the seed weighs when it is blended with the learned value.
#ETA_HEADROOM_PRIOR_LEGS=20
# A position older than ETA_POSITION_MAX_AGE_SECONDS, up to 30 minutes old: by
# tap + our own engine's minutes + this allowance (older, or none: no time).
# When the last position is a door or a pin:
#ETA_STALE_DOOR_ALLOWANCE_MINUTES=30
# When the last position is the depot's stamp of a load or a return:
#ETA_STALE_DEPOT_ALLOWANCE_MINUTES=20

# ----- Honest-ETA Phase 2: the capacity-aware plan (shadow engine) -----
# Records hidden promises and a weekly fit for the admin "Delivery time accuracy"
# page; customers see nothing from it. Every setting below is commented out on
# purpose (uncomment one to override; a blank value means the default). Defaults
# live in shared/business_config.py, "Delivery ETA: the capacity-aware plan".
# Kill switch: false stops the commit trigger, the 10-minute recompute and the
# Monday fit. Recreate celery_worker, celery_beat and business_app after editing.
#ETA_SHADOW_ENGINE_ENABLED=true
# A car (OPEN session) counts as working if active within this many hours.
#ETA_SESSION_ACTIVITY_HOURS=24
# A driver's typical start/end come from their last N plan days with deliveries,
# looked for within the lookback; fewer than ETA_MIN_DRIVER_DAYS uses the fleet's.
#ETA_HISTORY_WORK_DAYS=14
#ETA_HISTORY_LOOKBACK_DAYS=60
#ETA_MIN_DRIVER_DAYS=5
# Fleet seeds with no history, in minutes past local midnight (700 = 11:40, 1200 = 20:00).
#ETA_FLEET_START_SEED_MINUTES=700
#ETA_FLEET_END_SEED_MINUTES=1200
# No load or pickup this long after the typical start: start is rolled to now + the roll.
#ETA_START_GRACE_MINUTES=30
#ETA_START_ROLL_MINUTES=15
# Minutes a car spends loading at the depot.
#ETA_LOADING_ALLOWANCE_MINUTES=10
# A full load = the driver's median over their last N loaded sessions, else the fleet's, else the default.
#ETA_FULL_LOAD_SESSIONS=10
#ETA_RELOAD_FULL_BOTTLES_DEFAULT=30
# A stop without coordinates is placed this many km after the previous point (a decimal).
#ETA_UNKNOWN_LEG_KM=2.3
# A stop no car can take within this many plan days is "unconfirmed".
#ETA_UNCONFIRMED_HORIZON_DAYS=3
# Extra minutes on a not-started car's window end while it uses the seed spread.
#ETA_NOT_STARTED_EXTRA_HI_MINUTES=60
# Record a new hidden promise when the window end moved by this many minutes.
#ETA_RECORD_MOVE_MINUTES=15
# Commit trigger: "already queued" marker seconds, delay before a run, run-lock seconds
# (the recompute task's time limit is set at import from the lock seconds).
#ETA_RECOMPUTE_SCHEDULED_TTL_SECONDS=30
#ETA_RECOMPUTE_COUNTDOWN_SECONDS=5
#ETA_RECOMPUTE_LOCK_SECONDS=120
# When a moved promise would be worth a message (counted in shadow only, nothing is sent).
#ETA_CHANGE_LATER_MINUTES=30
#ETA_CHANGE_EARLIER_MINUTES=60
#ETA_CHANGE_MIN_GAP_MINUTES=60
#ETA_CHANGE_MAX_PER_ORDER=3
# Quiet hours, minutes past local midnight (1320 = 22:00 to 480 = 08:00).
#ETA_QUIET_START_MINUTES=1320
#ETA_QUIET_END_MINUTES=480
# The weekly fit: plan days read, minimum legs per curve bin, minimum depot pairs,
# the speed above which a leg is unreliable (km/h), the minimum pickup-to-delivered minutes.
#ETA_FIT_WINDOW_DAYS=28
#ETA_FIT_MIN_LEGS_PER_BIN=30
#ETA_FIT_MIN_DEPOT_PAIRS=15
#ETA_FIT_MAX_KMH=60
#ETA_FIT_MIN_PICKUP_TO_DELIVERED_MINUTES=2
# Accuracy page: the go-live share (a decimal) and its default range in days.
#ETA_GATE_KEPT_SHARE=0.90
#ETA_REPORT_DEFAULT_DAYS=14
# Windows: promises a bucket needs before it stands on its own, rounding (minutes),
# and the width in hours beyond which only "by HH:MM" is shown.
#ETA_WINDOW_MIN_PROMISES=30
#ETA_WINDOW_ROUND_MINUTES=30
#ETA_WINDOW_BY_ONLY_HOURS=4

# ===== Route Optimization =====
# How long traffic-aware vs static distance-matrix results are cached in Redis.
# Since the phase-2 cache split, the matrix wrapper's static (stop<->stop)
# tier reads MATRIX_CACHE_TTL_TRAFFIC_SECONDS only when a call passes
# traffic=True AND the provider that answered it is genuinely traffic-aware
# (Yandex, only reachable behind LEGACY_MATRIX_PROVIDERS_ENABLED) --
# self-hosted/public OSRM are free-flow regardless of the traffic flag, so
# they always get MATRIX_CACHE_TTL_STATIC_SECONDS. The raw traffic flag
# alone does NOT control the TTL. The live-origin tier always uses
# MATRIX_LIVE_ORIGIN_TTL_SECONDS regardless of source.
MATRIX_CACHE_TTL_TRAFFIC_SECONDS=1800
MATRIX_CACHE_TTL_STATIC_SECONDS=86400
# Live origin-row cache tier TTL (seconds).
MATRIX_LIVE_ORIGIN_TTL_SECONDS=120
# A driver's last_location_update older than this is treated as "stale".
DRIVER_LOCATION_FRESH_SECONDS=1800
# Flat per-stop service time (minutes) folded into route duration totals.
ROUTE_SERVICE_TIME_MINUTES=4
# Warehouse/depot coordinate. NEVER a route stop: used only as the
# last-resort route start anchor for route optimization. NOT the
# delivery-fee distance origin.
WAREHOUSE_LATITUDE=41.2995
WAREHOUSE_LONGITUDE=69.2401
# Staff bot URL for backend → bot push (route-updated, pool-insertion-suggestion).
STAFF_BOT_WEBHOOK_URL=http://staff_bot:8081

# ===== Self-hosted OSRM (route UX phase 2) =====
# Enable the `osrm` compose service (prepared data required in ./osrm_data/,
# see scripts/prepare_osrm_data.sh). Leave unset in dev to skip the service.
#COMPOSE_PROFILES=routing
# Primary distance-matrix provider. Empty string disables the tier — this is
# the documented rollback lever (docs/routing_engine_deploy_rollback.md).
OSRM_BASE_URL=http://osrm:5000
# EMERGENCY-ONLY fallback to the public OSRM demo server (its usage policy
# forbids production use). Off by default.
OSRM_PUBLIC_FALLBACK_ENABLED=false
# Legacy Yandex matrix tier: 401 on every production call (the key is not
# entitled to the matrix product) — off the hot path. Re-enable only after
# fixing the entitlement. HERE was deleted from the chain on 2026-08-16.
LEGACY_MATRIX_PROVIDERS_ENABLED=false

