# Blue Stream Admin UI Environment Variables (Vite)
# Vite only exposes vars prefixed with VITE_ to client code via import.meta.env.

# API Configuration
VITE_API_URL=http://localhost:5000/api/v1
VITE_WEBSOCKET_URL=ws://localhost:5000

# Application Settings
VITE_APP_NAME=Blue Stream Admin
VITE_VERSION=1.0.0

# Feature Flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_NOTIFICATIONS=true
VITE_ENABLE_EXPORT=true

# External Services
VITE_MAPS_API_KEY=your_maps_api_key_here
VITE_SENTRY_DSN=your_sentry_dsn_here
VITE_TINYMCE_API_KEY=your_tinymce_api_key_here

# Timezone (used by dateUtils.js)
VITE_TIMEZONE_OFFSET=+05:00
