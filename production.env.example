# Blue Stream Water Platform - Production Environment Configuration
# Copy this file to production.env and configure your production values

# =============================================================================
# APPLICATION ENVIRONMENT
# =============================================================================
ENVIRONMENT=production
FLASK_ENV=production
DEBUG=False

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
POSTGRES_DB=bluestream_production
POSTGRES_USER=bluestream
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Note: POSTGRES_PASSWORD is managed via Docker secrets

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
# Note: REDIS_PASSWORD is managed via Docker secrets

# =============================================================================
# BUSINESS CONFIGURATION
# =============================================================================
COMPANY_NAME=Blue Stream Water Delivery
COMPANY_PHONE=+998901234567
COMPANY_EMAIL=info@bluestream.uz
COMPANY_ADDRESS=Tashkent, Uzbekistan
COMPANY_WEBSITE=https://bluestream.uz

# =============================================================================
# DELIVERY CONFIGURATION
# =============================================================================
DEFAULT_DELIVERY_FEE=5000
FREE_DELIVERY_THRESHOLD=50000
DELIVERY_RADIUS_KM=20
MAX_DELIVERY_TIME_HOURS=24
MIN_ORDER_AMOUNT=10000

# =============================================================================
# PAYMENT GATEWAY CONFIGURATION
# =============================================================================
# PayMe Configuration
PAYME_MERCHANT_ID=your_payme_merchant_id
PAYME_TEST_MODE=false
PAYME_ENDPOINT_URL=https://checkout.paycom.uz

# Click Configuration
CLICK_MERCHANT_ID=your_click_merchant_id
CLICK_SERVICE_ID=your_click_service_id
CLICK_TEST_MODE=false
CLICK_ENDPOINT_URL=https://api.click.uz/v2/merchant

# Note: PAYME_SECRET_KEY and CLICK_SECRET_KEY are managed via Docker secrets

# =============================================================================
# MAPS CONFIGURATION
# =============================================================================
MAPS_PROVIDER=google
# Note: API keys are managed via Docker secrets

# =============================================================================
# NOTIFICATION CONFIGURATION (Optional)
# =============================================================================
# Email Configuration
SENDGRID_FROM_EMAIL=noreply@bluestream.uz
MAIL_SUPPORT_EMAIL=support@bluestream.uz
# Note: SENDGRID_API_KEY is managed via Docker secrets

# SMS Configuration
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_PHONE_NUMBER=+1234567890
# Note: TWILIO_AUTH_TOKEN is managed via Docker secrets

# =============================================================================
# FILE STORAGE CONFIGURATION
# =============================================================================
STORAGE_TYPE=local
UPLOAD_FOLDER=uploads/
MAX_UPLOAD_SIZE=16777216

# AWS S3 Configuration (if using S3)
# AWS_ACCESS_KEY_ID=your_aws_access_key_id
# AWS_S3_BUCKET=your_s3_bucket_name
# AWS_REGION=us-east-1
# Note: AWS_SECRET_ACCESS_KEY is managed via Docker secrets

# =============================================================================
# LOYALTY PROGRAM CONFIGURATION
# =============================================================================
LOYALTY_POINTS_RATIO=100
LOYALTY_REDEMPTION_RATIO=1
REFERRAL_BONUS_POINTS=500

# =============================================================================
# SUBSCRIPTION CONFIGURATION
# =============================================================================
SUBSCRIPTION_TRIAL_DAYS=7
SUBSCRIPTION_BILLING_DAY=1
MAX_SUBSCRIPTION_ITEMS=10

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
PASSWORD_MIN_LENGTH=8
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=1800
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=2592000

# CSRF Configuration
CSRF_TIME_LIMIT=3600
CSRF_SSL_STRICT=true

# Password Security
BCRYPT_ROUNDS=12
PASSWORD_REHASH_ON_LOGIN=true

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# =============================================================================
# FEATURE FLAGS
# =============================================================================
ENABLE_VOICE_MESSAGES=true
ENABLE_LOCATION_SHARING=true
ENABLE_SUBSCRIPTIONS=true
ENABLE_LOYALTY_PROGRAM=true
ENABLE_ADMIN_PANEL=true

# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_WINDOW=3600

# =============================================================================
# MONITORING AND ANALYTICS
# =============================================================================
ANALYTICS_ENABLED=true
PERFORMANCE_MONITORING=true
METRICS_ENABLED=true

# Sentry Configuration (Optional)
# SENTRY_DSN=your_sentry_dsn

# =============================================================================
# API CONFIGURATION
# =============================================================================
API_PREFIX=/api/v1
API_DOCS_URL=/docs

# =============================================================================
# TELEGRAM BOT CONFIGURATION
# =============================================================================
WEBHOOK_PORT=8443
ADMIN_CHAT_IDS=123456789,987654321
# Note: TELEGRAM_BOT_TOKEN is managed via Docker secrets

# =============================================================================
# CELERY CONFIGURATION
# =============================================================================
CELERY_WORKER_CONCURRENCY=4
CELERY_WORKER_MAX_MEMORY_PER_CHILD=200000
CELERY_TASK_SERIALIZER=json
CELERY_ACCEPT_CONTENT=json
CELERY_RESULT_SERIALIZER=json
CELERY_TIMEZONE=Asia/Tashkent

# =============================================================================
# GUNICORN CONFIGURATION
# =============================================================================
GUNICORN_WORKERS=4
GUNICORN_WORKER_CONNECTIONS=1000
GUNICORN_MAX_REQUESTS=1000
GUNICORN_MAX_REQUESTS_JITTER=100

# =============================================================================
# LANGUAGE CONFIGURATION
# =============================================================================
DEFAULT_LANGUAGE=en
DISPLAY_TIMEZONE=Asia/Tashkent

# COD Reconciliation / Cash Custody
COD_CASH_WARNING_THRESHOLD_UZS=200000
COD_CASH_ESCALATION_THRESHOLD_UZS=400000
COD_RECONCILIATION_CUTOFF_LOCAL=23:00
COD_REMINDER_INTERVAL_MINUTES=60

# =============================================================================
# CONTENT SECURITY POLICY
# =============================================================================
CSP_REPORT_ONLY=false

# =============================================================================
# DOCKER SECRETS CONFIGURATION
# =============================================================================
# The following secrets are managed via Docker secrets and should not be set here:
# - SECRET_KEY (Flask application secret key)
# - POSTGRES_PASSWORD (Database password)
# - TELEGRAM_BOT_TOKEN (Telegram bot token)
# - PAYME_SECRET_KEY (PayMe payment gateway secret)
# - CLICK_SECRET_KEY (Click payment gateway secret)
# - SENDGRID_API_KEY (SendGrid email API key)
# - TWILIO_AUTH_TOKEN (Twilio SMS API token)
# - GOOGLE_MAPS_API_KEY (Google Maps API key)
# - YANDEX_MAPS_API_KEY (Yandex Maps API key)
# - AWS_SECRET_ACCESS_KEY (AWS secret access key)
# - STRIPE_SECRET_KEY (Stripe payment secret key)
# - ENCRYPTION_KEY (Application encryption key)
# - REDIS_PASSWORD (Redis authentication password)
#
# These secrets are automatically loaded from Docker secrets files or
# environment variables with _FILE suffix (e.g., SECRET_KEY_FILE)

# =============================================================================
# DEPLOYMENT NOTES
# =============================================================================
# 1. Copy this file to production.env
# 2. Configure all required values above
# 3. Run: ./scripts/deploy-secrets.sh init
# 4. Run: ./scripts/deploy-secrets.sh setup-secrets
# 5. Run: ./scripts/deploy-secrets.sh deploy
#
# For more information, see: ./scripts/deploy-secrets.sh --help
