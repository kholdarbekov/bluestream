# Blue Stream Water Platform - Production Environment Configuration
# Copy this file to production.env and configure your production values

# =============================================================================
# APPLICATION ENVIRONMENT
# =============================================================================
ENVIRONMENT=production
FLASK_ENV=production
DEBUG=False

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
POSTGRES_DB=bluestream_production
POSTGRES_USER=bluestream
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Note: POSTGRES_PASSWORD is managed via Docker secrets

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
# Note: REDIS_PASSWORD is managed via Docker secrets

# =============================================================================
# BUSINESS CONFIGURATION
# =============================================================================
COMPANY_NAME=Aqua Element
COMPANY_PHONE=+998901234567
COMPANY_EMAIL=info@aqua-element.uz
COMPANY_ADDRESS=Tashkent, Uzbekistan
COMPANY_WEBSITE=https://aqua-element.uz
COMPANY_TIN=999999999

# =============================================================================
# DELIVERY CONFIGURATION
# =============================================================================
DEFAULT_DELIVERY_FEE=5000
FREE_DELIVERY_THRESHOLD=50000
DELIVERY_RADIUS_KM=20
MAX_DELIVERY_TIME_HOURS=24
MIN_ORDER_AMOUNT=10000

# =============================================================================
# PAYMENT GATEWAY CONFIGURATION
# =============================================================================
# PayMe Configuration
PAYME_MERCHANT_ID=your_payme_merchant_id
PAYME_TEST_MODE=false
PAYME_ENDPOINT_URL=https://checkout.paycom.uz

# Click Configuration
CLICK_MERCHANT_ID=your_click_merchant_id
CLICK_SERVICE_ID=your_click_service_id
CLICK_TEST_MODE=false
CLICK_ENDPOINT_URL=https://api.click.uz/v2/merchant

# Note: PAYME_SECRET_KEY and CLICK_SECRET_KEY are managed via Docker secrets

# =============================================================================
# MAPS CONFIGURATION
# =============================================================================
MAPS_PROVIDER=google
# Note: API keys are managed via Docker secrets

# =============================================================================
# ROUTING ENGINE CONFIGURATION (route UX phase 2)
# =============================================================================
# NOTE: this file is a legacy/parallel provisioning path
# (docker-compose.secrets.yml + scripts/deploy-secrets.sh) that is kept in
# sync for consistency but is NOT what the production Pi actually reads —
# see docs/routing_engine_deploy_rollback.md §3. That stack also does not
# define a `staff_bot` or `osrm` service at all. The live path is `.env`
# (from .env.example) with docker-compose.yml + docker-compose.production.yml.
#
# Enables the self-hosted `osrm` compose service (profile-gated; prepared
# data required in ./osrm_data/ — see scripts/prepare_osrm_data.sh). Leave
# unset/commented to skip the service entirely.
#COMPOSE_PROFILES=routing
# Primary distance-matrix provider. Empty string disables the tier — the
# documented rollback lever (docs/routing_engine_deploy_rollback.md).
OSRM_BASE_URL=http://osrm:5000
# EMERGENCY-ONLY fallback to the public OSRM demo server (its usage policy
# forbids production use). Off by default.
OSRM_PUBLIC_FALLBACK_ENABLED=false
# Legacy Yandex matrix tier: 401 on every production call (the key is not
# entitled to the matrix product) — off the hot path. Re-enable only after
# fixing the entitlement. HERE was deleted from the chain on 2026-08-16.
LEGACY_MATRIX_PROVIDERS_ENABLED=false
# Live origin-row cache tier TTL (seconds).
MATRIX_LIVE_ORIGIN_TTL_SECONDS=120
# Flat per-stop service time (minutes) folded into route duration totals.
ROUTE_SERVICE_TIME_MINUTES=4
# Warehouse/depot coordinate. NEVER a route stop: used only as the
# last-resort route start anchor for route optimization. NOT the
# delivery-fee distance origin.
WAREHOUSE_LATITUDE=41.2995
WAREHOUSE_LONGITUDE=69.2401
# Google Routes computeRoutes key — traffic-aware NEXT-LEG ETA only. Bills
# per REQUEST, never the matrix endpoint. Optional; unset means this tier
# is silently skipped and the OSRM/matrix duration is used instead.
# Deliberately a plain var here (not routed through Docker secrets like
# GOOGLE_MAPS_API_KEY/YANDEX_MAPS_API_KEY above) — get_secret() falls back to
# a plain env var when no secret file exists, and .env.example (the file
# this stack actually reads) documents it the same way. Route it through
# docker-compose.secrets.yml's `secrets:` block if this path is ever revived.
GOOGLE_ROUTES_API_KEY=

# =============================================================================
# NOTIFICATION CONFIGURATION (Optional)
# =============================================================================
# Email Configuration
SENDGRID_FROM_EMAIL=noreply@aqua-element.uz
MAIL_SUPPORT_EMAIL=support@aqua-element.uz
# Note: SENDGRID_API_KEY is managed via Docker secrets

# SMS Configuration
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_PHONE_NUMBER=+1234567890
# Note: TWILIO_AUTH_TOKEN is managed via Docker secrets

# =============================================================================
# FILE STORAGE CONFIGURATION
# =============================================================================
STORAGE_TYPE=local
UPLOAD_FOLDER=uploads/
MAX_UPLOAD_SIZE=16777216

# AWS S3 Configuration (if using S3)
# AWS_ACCESS_KEY_ID=your_aws_access_key_id
# AWS_S3_BUCKET=your_s3_bucket_name
# AWS_REGION=us-east-1
# Note: AWS_SECRET_ACCESS_KEY is managed via Docker secrets

# =============================================================================
# LOYALTY PROGRAM CONFIGURATION
# =============================================================================
LOYALTY_POINTS_RATIO=100
LOYALTY_REDEMPTION_RATIO=1
REFERRAL_BONUS_POINTS=500

# =============================================================================
# SUBSCRIPTION CONFIGURATION
# =============================================================================
SUBSCRIPTION_TRIAL_DAYS=7
SUBSCRIPTION_BILLING_DAY=1
MAX_SUBSCRIPTION_ITEMS=10

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
PASSWORD_MIN_LENGTH=8
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=1800
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=2592000

# CSRF Configuration
CSRF_TIME_LIMIT=3600
CSRF_SSL_STRICT=true

# Password Security
BCRYPT_ROUNDS=12
PASSWORD_REHASH_ON_LOGIN=true

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# =============================================================================
# FEATURE FLAGS
# =============================================================================
ENABLE_VOICE_MESSAGES=true
ENABLE_LOCATION_SHARING=true
ENABLE_SUBSCRIPTIONS=true
ENABLE_LOYALTY_PROGRAM=true
ENABLE_ADMIN_PANEL=true

# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_WINDOW=3600

# =============================================================================
# MONITORING AND ANALYTICS
# =============================================================================
ANALYTICS_ENABLED=true
PERFORMANCE_MONITORING=true
METRICS_ENABLED=true

# Sentry Configuration (Optional)
# SENTRY_DSN=your_sentry_dsn

# =============================================================================
# API CONFIGURATION
# =============================================================================
API_PREFIX=/api/v1
API_DOCS_URL=/docs

# =============================================================================
# TELEGRAM BOT CONFIGURATION
# =============================================================================
WEBHOOK_PORT=8443
ADMIN_CHAT_IDS=123456789,987654321
# Note: TELEGRAM_BOT_TOKEN is managed via Docker secrets

# =============================================================================
# CELERY CONFIGURATION
# =============================================================================
CELERY_WORKER_CONCURRENCY=4
CELERY_WORKER_MAX_MEMORY_PER_CHILD=200000
CELERY_TASK_SERIALIZER=json
CELERY_ACCEPT_CONTENT=json
CELERY_RESULT_SERIALIZER=json
CELERY_TIMEZONE=Asia/Tashkent

# CEL-006: Flower dashboard basic auth (REQUIRED).
# Format: user:password. Generate a strong password — even though Flower has
# no published port in production, this is defense-in-depth.
#   openssl rand -base64 32
FLOWER_BASIC_AUTH=admin:replace-with-strong-password

# =============================================================================
# GUNICORN CONFIGURATION
# =============================================================================
GUNICORN_WORKERS=4
GUNICORN_WORKER_CONNECTIONS=1000
GUNICORN_MAX_REQUESTS=1000
GUNICORN_MAX_REQUESTS_JITTER=100

# =============================================================================
# LANGUAGE CONFIGURATION
# =============================================================================
DEFAULT_LANGUAGE=en
DISPLAY_TIMEZONE=Asia/Tashkent

# COD Reconciliation / Cash Custody
COD_CASH_WARNING_THRESHOLD_UZS=200000
COD_CASH_ESCALATION_THRESHOLD_UZS=400000
COD_RECONCILIATION_CUTOFF_LOCAL=23:00
COD_REMINDER_INTERVAL_MINUTES=60

# =============================================================================
# CONTENT SECURITY POLICY
# =============================================================================
CSP_REPORT_ONLY=false

# =============================================================================
# DOCKER SECRETS CONFIGURATION
# =============================================================================
# The following secrets are managed via Docker secrets and should not be set here:
# - SECRET_KEY (Flask application secret key)
# - POSTGRES_PASSWORD (Database password)
# - TELEGRAM_BOT_TOKEN (Telegram bot token)
# - JWT_SECRET_KEY (JWT signing key for API auth tokens — distinct trust domain)
# - BOT_WEBHOOK_SECRET (HMAC for backend → telegram_bot /internal/* webhooks;
#   MUST equal the value telegram_bot reads. Mismatch = no payment notifications)
# - WEBHOOK_SECRET (HMAC for backend → staff_bot /internal/* webhooks; MUST
#   equal the value staff_bot reads. Distinct from BOT_WEBHOOK_SECRET — two bots,
#   two trust domains, two independent secrets)
# - PAYME_SECRET_KEY (PayMe payment gateway secret)
# - CLICK_SECRET_KEY (Click payment gateway secret)
# - SENDGRID_API_KEY (SendGrid email API key)
# - TWILIO_AUTH_TOKEN (Twilio SMS API token)
# - GOOGLE_MAPS_API_KEY (Google Maps API key)
# - YANDEX_MAPS_API_KEY (Yandex Maps API key)
# - AWS_SECRET_ACCESS_KEY (AWS secret access key)
# - STRIPE_SECRET_KEY (Stripe payment secret key)
# - ENCRYPTION_KEY (Application encryption key)
# - REDIS_PASSWORD (Redis authentication password)
#
# These secrets are automatically loaded from Docker secrets files or
# environment variables with _FILE suffix (e.g., SECRET_KEY_FILE)

# =============================================================================
# DEPLOYMENT NOTES
# =============================================================================
# 1. Copy this file to production.env
# 2. Configure all required values above
# 3. Run: ./scripts/deploy-secrets.sh init
# 4. Run: ./scripts/deploy-secrets.sh setup-secrets
# 5. Run: ./scripts/deploy-secrets.sh deploy
#
# For more information, see: ./scripts/deploy-secrets.sh --help
