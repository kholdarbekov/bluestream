# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
WEBHOOK_URL=https://yourdomain.com/webhook
WEBHOOK_PORT=8443
ADMIN_CHAT_IDS=123456789,987654321

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/water_business
REDIS_URL=redis://redis:6379/1

# Business App Configuration
BUSINESS_APP_URL=http://business_app:80

# JWT signing key for API auth tokens — must match backend JWT_SECRET_KEY.
JWT_SECRET_KEY=your-super-secret-jwt-key

# HMAC secret for /internal/* webhooks received from backend (e.g. payment
# success). MUST be identical to backend BOT_WEBHOOK_SECRET — a mismatch is
# the most common cause of payment-success notifications never arriving
# (logs show: "Invalid webhook signature from <ip>"). Distinct from
# JWT_SECRET_KEY: webhook trust ≠ token-auth trust.
BOT_WEBHOOK_SECRET=must-match-backend-bot-webhook-secret

# Payment Provider Configuration
PAYME_MERCHANT_ID=your_payme_merchant_id
PAYME_SECRET_KEY=your_payme_secret_key
PAYME_TEST_MODE=true

CLICK_MERCHANT_ID=your_click_merchant_id
CLICK_SERVICE_ID=your_click_service_id
CLICK_SECRET_KEY=your_click_secret_key
CLICK_TEST_MODE=true

TELEGRAM_PROVIDER_TOKEN=your_telegram_payment_token

# Notification Services
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@yourdomain.com

TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number

FCM_SERVER_KEY=your_fcm_server_key

# Language Configuration
DEFAULT_LANGUAGE=en

# Feature Flags
ENABLE_VOICE_MESSAGES=true
ENABLE_LOCATION_SHARING=true
ENABLE_SUBSCRIPTIONS=true
ENABLE_LOYALTY_PROGRAM=true
ENABLE_ADMIN_PANEL=true

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW=60

# Security
ENCRYPTION_KEY=your-encryption-key-32-chars-long
